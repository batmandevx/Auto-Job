# Copy to .env and pick one provider.
PORT=8787

# --- Gemini (recommended) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite      # fast: form answers
# GEMINI_HEAVY_MODEL=gemini-3.5-pro       # quality: resume parsing + tailoring + cover letters (stronger, slower)
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash   # used when a model is out of quota

# --- Stronger model ONLY for resumes + cover letters (optional) ---
# Form answers, OTPs and the visual check stay on the fast LLM_PROVIDER above. Quality-critical calls
# (resume import, tailoring, cover letters) go to this provider/model instead:
# HEAVY_LLM_PROVIDER=anthropic            # gemini / anthropic / openai / ollama
# ANTHROPIC_HEAVY_MODEL=claude-opus-5-5
# (or OPENAI_HEAVY_MODEL=gpt-5 with HEAVY_LLM_PROVIDER=openai, or OLLAMA_HEAVY_MODEL=qwen3.5:32b with =ollama)

# --- Fallback providers (optional): tried in order when the primary AI is out of quota / down ---
# OpenAI-compatible providers: groq, openrouter, nvidia, huggingface, litellm (any local proxy).
# Form answers, tailoring and cover letters all fall back; the visual check and research stay on Gemini.
# FALLBACK_PROVIDERS=groq,openrouter,litellm
# GROQ_API_KEY=                       # default model: openai/gpt-oss-120b (GROQ_MODEL to change)
# OPENROUTER_API_KEY=                 # default model: google/gemma-4-31b-it:free (OPENROUTER_MODEL to change)
# NVIDIA_API_KEY=                     # default model: deepseek-ai/deepseek-v4.1-flash (NVIDIA_MODEL to change)
# HUGGINGFACE_API_KEY=                # set HUGGINGFACE_MODEL too (e.g. Qwen/Qwen3.8-27B)
# LITELLM_BASE_URL=http://localhost:4000/v1    # any LiteLLM / OpenAI-compatible proxy
# LITELLM_API_KEY=
# LITELLM_MODEL=bedrock-nova-2-lite

# --- Local: run `ollama serve` and `ollama pull qwen3.5:9b` (or any model you have) ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
# OLLAMA_HEAVY_MODEL=qwen3.5:32b          # a bigger local model just for resumes + cover letters

# --- Any OpenAI-compatible API (OpenAI, Gemini, Groq, LM Studio...) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_HEAVY_MODEL=gpt-5                # stronger model just for resumes + cover letters


# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# --- Gmail (read-only) for OTP / verification emails ---
# App Password: https://myaccount.google.com/apppasswords (needs 2-Step Verification)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=
