  "keywords": [
    "job-application",
    "autofill",
    "resume",
    "ats",
    "cover-letter",
    "chrome-extension",
    "workday",
    "gemini",
    "ollama",
    "local-first"
  ],
  "author": "Ayush Upadhyay (https://github.com/batmandevx)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "multer": "^1.4.4",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2"
  },
  "repository": {
    "type": "git",
